{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taoyuan-rental-line-watchdog",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "FB_INBOX",
      "id": "e1c7e0c965134908bfdf294d0bd833ae"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "FlySpacesky",
    "GITHUB_REPOSITORY": "taoyuan-rental-digest",
    "GITHUB_WORKFLOW": "rental-digest.yml",
    "GITHUB_BRANCH": "main",
    "FACEBOOK_AUTO_REFRESH": "true"
  },
  "triggers": {
    "crons": [
      "35-59 1 * * *",
      "5-30 8 * * *",
      "5-30 14 * * *"
    ]
  }
}
